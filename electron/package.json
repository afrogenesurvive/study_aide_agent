{
  "name": "study-aide-electron",
  "version": "0.0.2",
  "private": true,
  "description": "Study Aide desktop shell (main + preload + renderer).",
  "license": "MIT",
  "main": "dist/src/main/index.js",
  "scripts": {
    "dev": "concurrently -n renderer,main,electron -c cyan,yellow,magenta --kill-others \"npm run dev:renderer\" \"npm run watch:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "watch:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist/src/main/index.js && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "mammoth": "^1.8.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.studyaide.agent",
    "productName": "Study Aide",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared"
      },
      {
        "from": "../mcp",
        "to": "mcp"
      },
      {
        "from": "../agent-config",
        "to": "agent-config"
      },
      {
        "from": "../data",
        "to": "data"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage"
      ]
    },
    "artifactName": "Study-Aide-${version}-${arch}.${ext}"
  }
}
