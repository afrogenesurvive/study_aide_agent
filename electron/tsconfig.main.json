{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/main/**/*", "src/shared/**/*", "services/**/*"],
  "exclude": ["**/*.test.ts", "dist", "node_modules"]
}
