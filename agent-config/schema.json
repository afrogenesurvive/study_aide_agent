{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Study Aide agent-config",
  "description": "Validates either agent-config/tools.json (an array of tool definitions) or agent-config/pipeline.json (the pipeline set).",
  "oneOf": [{ "$ref": "#/definitions/tools_file" }, { "$ref": "#/definitions/pipeline_file" }],
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["name", "description", "terminal", "handler", "inputSchema"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Lowercase snake_case tool name."
        },
        "description": { "type": "string", "maxLength": 1000 },
        "terminal": {
          "type": "boolean",
          "description": "Terminal tools perform an irreversible side effect and always require the review gate."
        },
        "handler": {
          "type": "string",
          "enum": ["bridge", "direct"],
          "description": "direct = handled in-process; bridge = proxied to an MCP server."
        },
        "inputSchema": { "type": "object" }
      }
    },
    "tools_file": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/tool" }
    },
    "pipeline_step": {
      "type": "object",
      "required": ["id", "toolName", "label", "description", "enabled", "isTerminal"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^step-[0-9]+$" },
        "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "systemPromptTemplate": { "type": "string", "maxLength": 4000 },
        "hintTemplate": { "type": "string", "maxLength": 1000 },
        "enabled": { "type": "boolean" },
        "isTerminal": { "type": "boolean" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["name", "label", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/definitions/pipeline_step" }
        }
      }
    },
    "pipeline_file": {
      "type": "object",
      "required": ["pipelines"],
      "additionalProperties": false,
      "properties": {
        "max_pipeline_steps": { "type": "integer", "minimum": 1, "maximum": 40 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "retry_base_delay_ms": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "llm_context_window": { "type": "integer", "minimum": 0 },
        "terminal_tools": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "pipelines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/pipeline" }
        }
      }
    }
  }
}
