# ─────────────────────────────────────────────────────────────────────────────
# Study Aide — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and NEVER committed.
#
# Precedence (highest → lowest):  userData/config.json  >  process.env / .env  >  DEFAULTS
# Anything you set here shows up in the Settings panel as source "environment".
#
# NOTE: values in this file are read by the Electron main process and by any
# standalone Node entry point (feeds, scripts, future MCP servers). Leave a key
# blank/absent to fall through to the next layer.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# deepseek | openai | anthropic | ollama
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=32768

# ── Google (Gmail + Calendar + Tasks — one OAuth2 refresh token) ─────────────
# Create the token with:  node scripts/gmail-auth.mjs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me
GOOGLE_CALENDAR_ID=primary

# ── Notifications ────────────────────────────────────────────────────────────
# email,calendar,push
NOTIFY_CHANNELS=email,calendar,push
# "false" keeps every send/create behind the review gate.
NOTIFY_AUTOSEND=false
# Minutes before a session, e.g. 1440,60,10
REMINDER_OFFSETS=1440,60,10
DAILY_DIGEST_TIME=08:00
WEEKLY_REVIEW_DAY=saturday

# ── Study ────────────────────────────────────────────────────────────────────
DAILY_STUDY_TARGET=90
SESSION_LENGTH=20
BREAK_LENGTH=5
TIMEZONE=America/Jamaica
EXAM_DATE=

# ── FSRS (phase 2) ───────────────────────────────────────────────────────────
FSRS_DESIRED_RETENTION=0.9
FSRS_MAX_INTERVAL=365
NEW_CARDS_PER_DAY=20

# ── Syllabus ─────────────────────────────────────────────────────────────────
SYLLABUS_ACTIVE_ID=
# auto | csv | json | md | pdf
SYLLABUS_IMPORT_FORMAT=auto

# ── Appearance ───────────────────────────────────────────────────────────────
# system | dark | light
APPEARANCE_THEME=system
APPEARANCE_ACCENT_COLOR=#2f81f7
# small | medium | large | x-large | xx-large
APPEARANCE_FONT_SIZE=medium
APPEARANCE_SIDEBAR_WIDTH=260

# ── Ops ──────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
USAGE_TRACKING_ENABLED=true
# Override the SQLite location (defaults to <userData>/study.db).
STUDY_DB_PATH=
